# CivicPulse — docker compose environment.
#
# NOT NEEDED for local dev: `docker compose --profile dev up --build` boots the
# whole stack (backend + frontend + otel-collector + postgres/redis/mongo) with
# the built-in dev defaults. Copy this file to `.env` only when you need to
# override those defaults — e.g. for a production-style run against external
# datastores, or to light up New Relic + LLM integrations.
#
#   Copy:  Copy-Item docker/.env.example docker/.env   (PowerShell)
#          cp docker/.env.example docker/.env          (bash)
#   Use:   docker compose --profile dev up --build     (or plain `docker compose up` for smoke)

# ── Datastores (defaults point at the in-compose dev services) ──────────────
# DATABASE_URL=postgresql://civicpulse:changeme@postgres:5432/civicpulse
# REDIS_URL=redis://redis:6379
# MONGODB_URI=mongodb://mongo:27017
# For external services, point these at Aiven/Upstash/Atlas and set:
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ── REQUIRED in production ───────────────────────────────────────────────────
# The dev default below must never reach production (weak JWT-signing secret):
SECRET_KEY=change-me-to-a-long-random-value
# ENVIRONMENT=production        # production: disables auto-create-table at boot

# ── LLM / embeddings (fail-open in the app: empty keeps dev working) ────────
# OPENAI_API_KEY=...
# HF_TOKEN=...

# ── Layer-2 New Relic transport (agent owns the key, NOT the app) ───────────
# NEW_RELIC_ENABLED=true
# NEW_RELIC_LICENSE_KEY=xxxxxxxx    # collector-only secret
# NEW_RELIC_OTLP_ENDPOINT=http://otel-collector:4318
# METRICS_TOKEN=                    # Bearer gate for /metrics

# ── Frontend / OAuth / SMTP (optional) ───────────────────────────────────────
# FRONTEND_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# SMTP_HOST=...
# SMTP_USER=...
# SMTP_PASS=...
# ALERT_EMAIL_TO=...