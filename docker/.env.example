# CivicPulse compose environment — copy to `docker/.env` and fill in.
# Used by: docker compose -f docker/docker-compose.yml up
#
# 3-layer New Relic: the backend app never holds a vendor key. The Layer-2
# otel-collector service owns NEW_RELIC_LICENSE_KEY and forwards the app's
# OTLP logs + scraped /metrics to New Relic (Layer 3).

# ── Application (required) ──────────────────────────────────────────────
DATABASE_URL=postgresql://civicpulse_user:civicpulse_password@db:5432/civicpulse_db
REDIS_URL=redis://redis:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MONGODB_URI=mongodb://mongo:27017
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64
OPENAI_API_KEY=
HF_TOKEN=
ENVIRONMENT=production

# ── 3-layer New Relic (optional) ────────────────────────────────────────
# Layer-1 app: export OTLP logs to the collector. Keep OFF unless the
# [observability] extras are installed in the backend image and a license key
# is set below.
NEW_RELIC_ENABLED=false
# Layer-2 collector secret (agent-only; never shipped to the app).
NEW_RELIC_LICENSE_KEY=
# Bearer token the backend requires for /metrics scrapes. Leave empty in dev;
# if set, set the same value here AND on the backend service.
METRICS_TOKEN=