# CivicPulse — docker compose environment.
#
# REQUIRED for every run, dev included: compose refuses to boot the backend
# without `SECRET_KEY` — there is deliberately no dev default, because a
# baked-in default is a deployable trivial-signature JWT oracle. Copy this
# file to `.env`, set `SECRET_KEY` to a fresh random value, then start.
#
#   Copy:  Copy-Item docker/.env.example docker/.env   (PowerShell)
#          cp docker/.env.example docker/.env          (bash)
#   Key:   python -c 'import secrets; print(secrets.token_urlsafe(64))'
#   Use:   docker compose --profile dev up --build     (or plain `docker compose up` for smoke)

# ── Datastores (defaults point at the in-compose dev services) ──────────────
# DATABASE_URL=postgresql://civicpulse:changeme@postgres:5432/civicpulse
# REDIS_URL=redis://redis:6379
# MONGODB_URI=mongodb://mongo:27017
# For external services, point these at Aiven/Upstash/Atlas and set:
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ── REQUIRED in every environment ────────────────────────────────────────────
# No dev default exists: compose fails fast when SECRET_KEY is unset, and the
# backend rejects known placeholder values like the one below. Generate a real
# value before the first `up`:
SECRET_KEY=change-me-to-a-long-random-value
# ENVIRONMENT=production        # production: disables auto-create-table at boot
# COOKIE_SECURE=true            # production behind HTTPS: adds the `secure` flag
#                               # to every auth cookie; passed through to the
#                               # backend by docker-compose.yml. Leave unset (or
#                               # false) for plain-HTTP dev — browsers drop
#                               # secure cookies over http://.

# ── LLM / embeddings (fail-open in the app: empty keeps dev working) ────────
# OPENAI_API_KEY=...
# HF_TOKEN=...

# ── Layer-2 OTLP transport (agent owns the key, NOT the app) ────────────────
# The app pushes logs + traces + metrics over OTLP; there is no /metrics scrape.
# NEW_RELIC_ENABLED=true
# NEW_RELIC_LICENSE_KEY=xxxxxxxx    # collector-only secret
# NEW_RELIC_OTLP_ENDPOINT=http://otel-collector:4318
# SERVICE_VERSION=0.1.0             # collector-side service.version resource attr
# OTLP receiver basic auth — the SAME pair goes to BOTH the collector (which
# enforces it) and the backend (which sends the Authorization header). The
# compose defaults are civicpulse/civicpulse; CHANGE THEM before exposing :4318.
# OTLP_AUTH_USER=civicpulse
# OTLP_AUTH_PASSWORD=civicpulse
# Optional second sink (Grafana Cloud): set BOTH below, then load the overlay in
# docker-compose.yml by appending --config=/etc/otelcol-contrib/config.grafana.yaml
# to the otel-collector service's `command`. Zero application change.
# GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# GRAFANA_OTLP_TOKEN=Basic <base64(instance_id:api_token)>

# ── Frontend / OAuth / SMTP (optional) ───────────────────────────────────────
# BACKEND_URL is the API proxy's server-side base URL — the URL the *Next.js
# server* uses to reach the backend. In Docker Compose this must be the
# in-network name `http://backend:8000`; `localhost:8000` from inside the
# frontend container resolves to the container itself and every proxied call
# will 502. The compose file already sets this correctly; only override it if
# you relocate the backend.
# BACKEND_URL=http://backend:8000
# FRONTEND_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# SMTP_HOST=...
# SMTP_USER=...
# SMTP_PASS=...
# ALERT_EMAIL_TO=...