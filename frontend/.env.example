# Copy to frontend/.env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables instead.
#
# Both must be the PUBLIC Render backend URL. Vercel cannot resolve Render's
# private service name (http://civicpulse-api:8000), and the browser needs the
# public URL for WebSockets. Change these BEFORE the Vercel build:
# NEXT_PUBLIC_API_URL is baked into the client bundle at build time.
#
# The canonical frontend is https://civicpulse-civic-ai8.vercel.app;
# https://civicpulse.vercel.app is a different Vercel project. Register the
# Google/GitHub OAuth callbacks under that URL:
#   <frontend>/api/proxy/auth/oauth/google/callback
#   <frontend>/api/proxy/auth/oauth/github/callback

BACKEND_URL=https://civicpulse-api.onrender.com
NEXT_PUBLIC_API_URL=https://civicpulse-api.onrender.com
