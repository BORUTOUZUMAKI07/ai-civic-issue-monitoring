# Backend environment template — copy this to `backend/.env`:
#     cp backend/.env.example backend/.env         (bash)
#     Copy-Item backend/.env.example backend/.env  (PowerShell)
# The backend loads this file by absolute path (see src/core/config.py), so it is
# read regardless of which directory you launch the app from. There is no
# repo-root `.env`; `prefect/.env` and `docker/.env` are separate, location-scoped
# files (see their own `.env.example`).
DATABASE_URL=postgresql://civicpulse_user:civicpulse_password@localhost:5432/civicpulse_db
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=civicpulse_password
POSTGRES_DB=civicpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB
MONGODB_URI=mongodb://admin:adminpassword@localhost:27017
MONGODB_DB=civicpulse_analytics

# Redis
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT
# The placeholder below is rejected at startup — SECRET_KEY must be a real,
# fresh random value of 32+ chars (python -c 'import secrets; print(secrets.token_urlsafe(64))').
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
FRONTEND_URL=http://localhost:3000

# LLM Provider (Groq or OpenAI)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-groq-or-openai-key

# HuggingFace (for embeddings)
HF_TOKEN=your-huggingface-token

# RAG Config
# These are real knobs read by the retrieval layer (src/rag/retrieval.py,
# src/rag/context.py).
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5
RAG_MAX_CONTEXT_ISSUES=5
# Opt-in weighted re-ranking: blend similarity with recency/severity/resolution
# instead of raw cosine. Off by default; measure with
# `python scripts/evaluate_ml.py --retrieval --weighted` before enabling. Weights
# are normalized by their sum, so they need not add to exactly 1.0.
RAG_WEIGHTED_RERANK=false
RAG_SIMILARITY_WEIGHT=0.3
RAG_RECENCY_WEIGHT=0.2
RAG_SEVERITY_WEIGHT=0.25
RAG_RESOLUTION_WEIGHT=0.25
RAG_RECENCY_HALF_LIFE_DAYS=30
# Opt-in: feed retrieved history to the LLM classifier, and re-consult it when the
# intake gate is unsure. Off by default.
RAG_CLASSIFY_ENABLED=false
RAG_CLASSIFY_MIN_CONFIDENCE=0.6
# Opt-in hybrid retrieval (dense vector + BM25 via Reciprocal Rank Fusion).
RETRIEVAL_HYBRID=false

# ML Model
MODEL_PATH=models/model.pth
DRIFT_WINDOW_SIZE=10

# DagsHub / MLflow
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_REPO=ai-civic-issue-monitoring
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/ai-civic-issue-monitoring.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token

# New Relic (optional) — 3-layer OTLP observability. The app exports structured
# logs, spans AND metrics over OTLP/HTTP to the Layer-2 OpenTelemetry collector
# (docker compose ``otel-collector`` service), which owns NEW_RELIC_LICENSE_KEY
# and fans them out to New Relic; the app never holds the vendor key and there
# is no /metrics scrape path. Requires the [observability] extras
# (opentelemetry-sdk + OTLP HTTP exporter + instrumentors).
NEW_RELIC_ENABLED=false
# Layer-2 collector OTLP/HTTP base URL. Local: http://localhost:4318 (the
# docker-compose collector).
NEW_RELIC_OTLP_ENDPOINT=http://localhost:4318
NEW_RELIC_EXPORT_INTERVAL_SECONDS=30
NEW_RELIC_APP_NAME=CivicPulse-API
# Extra OTLP request headers as a JSON object. Leave empty unless the collector's
# OTLP receiver is basicauth-gated, in which case send the matching header:
# NEW_RELIC_OTLP_HEADERS={"Authorization": "Basic <base64(user:pass)>"}

# --- OAuth (Google / GitHub) ---
# Get credentials from the Google Cloud Console (Authorized redirect URI must be:
#   http://localhost:3000/api/proxy/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App (redirect URI must be:
#   http://localhost:3000/api/proxy/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin of the API (used to validate callbacks). In dev this is the backend.
BACKEND_URL=http://localhost:8000

# --- SMTP (outbound email: password reset / drift alerts) ---
# Gmail example:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<Gmail App Password (not your normal login password)>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicPulse <no-reply@civicpulse.local>
ALERT_EMAIL_TO=

# --- Password reset ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EMAIL_SUBJECT=CivicPulse password reset

ENVIRONMENT=development
