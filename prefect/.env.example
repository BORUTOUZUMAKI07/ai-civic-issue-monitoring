# ===========================================================
# CivicPulse Prefect environment variables
# Copy this file to .env and fill in values.
#
#   cp .env.example .env
#
# `load_prefect_env()` reads this file when you run
#     pixi run -e prefect python deploy.py
# It is gitignored via the root `.gitignore` (`**/.env`) and has
# never been tracked -- keep it that way. Never paste real values
# into this example file.
# ===========================================================

# --- Prefect Cloud work pool (optional) ---
# Name of the managed work pool deploy.py creates if missing.
PREFECT_WORK_POOL=civicpulse-managed

# --- PostgreSQL (Aiven) ---
# MUST be a PLAIN `postgresql://` URI. psycopg2 (installed via PIP_PACKAGES on
# the serverless container) cannot parse the `postgresql+asyncpg://` scheme the
# backend's async engine uses, so do not copy that value across verbatim.
CIVICPULSE_DB_URI=postgresql://user:changeme@host:25023/defaultdb?sslmode=require

# --- MongoDB Atlas ---
CIVICPULSE_MONGO_URI=mongodb+srv://user:changeme@cluster.example.net/

# --- DagsHub (retrain-model pushes, MLflow logging) ---
# Generate with: dvc login   (or a DagsHub PAT from Settings -> Tokens)
DAGSHUB_TOKEN=your-dagshub-token
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_REPO=ai-civic-issue-monitoring
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/ai-civic-issue-monitoring.mlflow

# --- Drift alerting (drift-detection flow) ---
# Leave blank to disable. All four SMTP_* plus ALERT_EMAIL_TO are needed for
# email; SLACK_WEBHOOK_URL is independent and optional.
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ===========================================================
# How these values reach the scheduled runs
# ===========================================================
# deploy.py splits them in two:
#
#   * The five SENSITIVE keys (CIVICPULSE_DB_URI, CIVICPULSE_MONGO_URI,
#     DAGSHUB_TOKEN, SMTP_PASS, SLACK_WEBHOOK_URL) are pushed into Prefect
#     Secret blocks named `civicpulse-db-uri`, `civicpulse-mongo-uri`,
#     `dagshub-token`, `smtp-pass` and `slack-webhook-url`, and referenced from
#     the deployment as `{{ prefect.blocks.secret.<name> }}`. They are NOT
#     stored in the deployment record, so `prefect deployment inspect` and the
#     Prefect Cloud API never see them.
#
#   * Everything else (identifiers, SMTP routing) is stored in the clear on the
#     deployment, which is fine because it is not secret.
#
# Running `python deploy.py` is idempotent: it re-saves the Secret blocks from
# this file's current values before creating the deployments, so editing a
# credential here only requires a re-run -- no manual block surgery.
