# ===========================================
# CivicPulse Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# --- Database ---
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=civicpulse_db
DATABASE_URL=postgresql://civicpulse_user:changeme@localhost:5432/civicpulse_db

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGODB_URI=mongodb://admin:changeme@localhost:27017

# --- Redis ---
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=changeme

# --- JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
SECRET_KEY=changeme

# --- Application ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# --- ML Model ---
MODEL_PATH=models/model.pth

# --- DagsHub / MLflow ---
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_REPO=ai-civic-issue-monitoring
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/ai-civic-issue-monitoring.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token

# --- LLM Provider ---
# Option A: Groq (free, fast, no embedding support)
OPENAI_API_KEY=gsk_your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# Option B: OpenAI (paid, supports embeddings)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536

# --- RAG ---
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5

# --- OAuth (Google / GitHub) ---
# Google Cloud OAuth client. Authorized redirect URI must be:
#   http://localhost:3000/api/proxy/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App. Callback URL:
#   http://localhost:3000/api/proxy/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP (outbound email: password reset / drift alerts) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASS=<App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicPulse <no-reply@civicpulse.local>
ALERT_EMAIL_TO=

# --- Password reset ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EMAIL_SUBJECT=CivicPulse password reset

# --- Prefect Cloud (orchestration) ---
# The 5 Prefect flows live in prefect/flows/. Credentials below are read by the
# flows on the serverless container (env first, then the Prefect Secret block
# "dagshub-token"). Schedules are UTC.
#   - retrain-model      Sun 03:00 + event-driven check
#   - drift-detection    daily 02:00
#   - daily-report       daily 08:00
#   - sla-monitoring     hourly
#   - audit-log-archival 1st of month 03:00
# Deploy: cd prefect && python deploy.py
CIVICPULSE_DB_URI=postgresql://avnadmin:changeme@host:25023/defaultdb?sslmode=require
CIVICPULSE_MONGO_URI=mongodb://user:changeme@host:27017/civicpulse_analytics?authSource=admin
DAGSHUB_TOKEN=your-dagshub-token
